package tzdata;

use ecosystem::datetime;
use std::bytes;
use std::crypto::hash;
use std::encoding::base64;

fn locate(name: string) -> Option[isize] {
    let mut low = 0;
    let mut high = ENTRY_COUNT;
    while low < high {
        let middle = low + (high - low) / 2;
        let candidate = ENTRIES[middle].0;
        if candidate < name {
            low = middle + 1;
        } else {
            high = middle;
        }
    }
    if low < ENTRY_COUNT && ENTRIES[low].0 == name {
        Option::Some(low)
    } else {
        Option::None
    }
}

pub fn names() -> Vec[string] {
    let result: Vec[string] = Vec::with_capacity(ENTRY_COUNT);
    for index in 0..ENTRY_COUNT {
        result.push(ENTRIES[index].0);
    }
    result
}

pub fn contains(name: string) -> bool {
    locate(name).is_some()
}

pub fn checksum(name: string) -> Option[string] {
    locate(name).map(|index| ENTRIES[index].2)
}

pub fn zone_bytes(name: string) -> Result[bytes::Bytes, datetime::Error] {
    let index = locate(name).ok_or(datetime::Error::TimeZone("unknown bundled timezone"))?;
    let decoded = base64::decode(ENTRIES[index].1).map_err(
        |_| datetime::Error::Invalid("invalid bundled timezone encoding"),
    )?;
    if decoded.len() > 16777216 || hash::sha256(decoded) != ENTRIES[index].2 {
        return Result::Err(datetime::Error::Invalid("bundled timezone checksum mismatch"))
    }
    Result::Ok(decoded)
}

pub fn load(name: string) -> Result[datetime::TimeZone, datetime::Error] {
    datetime::TimeZone::from_tzif(name, zone_bytes(name)?)
}

pub fn load_versioned(name: string, expected_version: string) -> Result[
    datetime::TimeZone,
    datetime::Error,
] {
    if expected_version != VERSION {
        return Result::Err(datetime::Error::TimeZone("bundled timezone version mismatch"))
    }
    load(name)
}
