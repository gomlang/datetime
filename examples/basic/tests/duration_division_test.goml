package tests;

use ecosystem::datetime::{Duration, Error};
use std::testing;

#[test]
fn duration_division_truncates_toward_zero_at_nanosecond_precision() -> () {
    for nanos in Vec::from_array([-2000000001, -1500000000, -1, 0, 1, 1500000000, 2000000001]) {
        for divisor in -31..=31 {
            if divisor == 0 {
                continue
            }
            let result = testing::expect_ok(
                Duration::nanoseconds(nanos).checked_divide(divisor.to_i64()),
                "divide",
            );
            testing::assert_eq(
                testing::expect_ok(result.checked_nanoseconds(), "nanoseconds"),
                nanos / divisor.to_i64(),
            );
        }
    }
    testing::assert_eq(
        testing::expect_err(Duration::nanoseconds(1).checked_divide(0), "zero divisor"),
        Error::Invalid("duration division by zero"),
    );
    let upper = testing::expect_ok(Duration::new(315537897600, 999999999), "upper");
    testing::assert_err(upper.checked_divide(-1));
    testing::assert_eq(testing::expect_ok(upper.checked_divide(1), "identity"), upper);
}

#[test]
fn full_range_duration_division_matches_independent_integer_vectors() -> () {
    let cases: Vec[(i64, i64, i64, i64, i64)] = Vec::from_array(
        [
            (315537897600, 999999999, 2, 157768948800, 499999999),
            (315537897600, 999999999, -2, -157768948801, 500000001),
            (315537897600, 999999999, 3, 105179299200, 333333333),
            (315537897600, 999999999, -7, -45076842515, 571428572),
            (315537897600, 999999999, 999999999, 315, 537897916),
            (315537897600, 999999999, 1000000000, 315, 537897600),
            (315537897600, 999999999, 1000000001, 315, 537897285),
            (315537897600, 999999999, 9223372036854775807, 0, 34),
            (315537897600, 999999999, (-9223372036854775807 - 1), -1, 999999966),
            (-315537897600, 0, 2, -157768948800, 0),
            (-315537897600, 0, -2, 157768948800, 0),
            (-315537897600, 0, 3, -105179299200, 0),
            (-315537897600, 0, -7, 45076842514, 285714285),
            (-315537897600, 0, 999999999, -316, 462102085),
            (-315537897600, 0, 1000000000, -316, 462102400),
            (-315537897600, 0, 1000000001, -316, 462102716),
            (-315537897600, 0, 9223372036854775807, -1, 999999966),
            (-315537897600, 0, (-9223372036854775807 - 1), 0, 34),
            (-315537897600, 1, 2, -157768948800, 1),
            (-315537897600, 1, -2, 157768948799, 999999999),
            (-315537897600, 1, 3, -105179299200, 1),
            (-315537897600, 1, -7, 45076842514, 285714285),
            (-315537897600, 1, 999999999, -316, 462102085),
            (-315537897600, 1, 1000000000, -316, 462102401),
            (-315537897600, 1, 1000000001, -316, 462102716),
            (-315537897600, 1, 9223372036854775807, -1, 999999966),
            (-315537897600, 1, (-9223372036854775807 - 1), 0, 34),
            (315537897599, 999999999, 2, 157768948799, 999999999),
            (315537897599, 999999999, -2, -157768948800, 1),
            (315537897599, 999999999, 3, 105179299199, 999999999),
            (315537897599, 999999999, -7, -45076842515, 714285715),
            (315537897599, 999999999, 999999999, 315, 537897915),
            (315537897599, 999999999, 1000000000, 315, 537897599),
            (315537897599, 999999999, 1000000001, 315, 537897284),
            (315537897599, 999999999, 9223372036854775807, 0, 34),
            (315537897599, 999999999, (-9223372036854775807 - 1), -1, 999999966),
            (-1, 999999999, 2, 0, 0),
            (-1, 999999999, -2, 0, 0),
            (-1, 999999999, 3, 0, 0),
            (-1, 999999999, -7, 0, 0),
            (-1, 999999999, 999999999, 0, 0),
            (-1, 999999999, 1000000000, 0, 0),
            (-1, 999999999, 1000000001, 0, 0),
            (-1, 999999999, 9223372036854775807, 0, 0),
            (-1, 999999999, (-9223372036854775807 - 1), 0, 0),
            (0, 1, 2, 0, 0),
            (0, 1, -2, 0, 0),
            (0, 1, 3, 0, 0),
            (0, 1, -7, 0, 0),
            (0, 1, 999999999, 0, 0),
            (0, 1, 1000000000, 0, 0),
            (0, 1, 1000000001, 0, 0),
            (0, 1, 9223372036854775807, 0, 0),
            (0, 1, (-9223372036854775807 - 1), 0, 0),
        ],
    );
    for item in cases {
        let duration = testing::expect_ok(Duration::new(item.0, item.1), "source");
        let result = testing::expect_ok(duration.checked_divide(item.2), "division vector");
        testing::assert_eq(result.floor_seconds(), item.3);
        testing::assert_eq(result.subsecond_nanoseconds().to_i64(), item.4);
    }
}
